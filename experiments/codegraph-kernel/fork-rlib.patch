diff --git a/codegraph-kernel/src/api.rs b/codegraph-kernel/src/api.rs
new file mode 100644
index 00000000..939851e2
--- /dev/null
+++ b/codegraph-kernel/src/api.rs
@@ -0,0 +1,204 @@
+//! Plain-Rust extraction API (local fork change): the same per-file walk
+//! `extract_file` runs for Node, decoded from the flat buffers into owned
+//! structs, with no napi in the way. Nothing here changes what the walkers
+//! emit; it only reads the wire layout documented in buffers.rs.
+
+use crate::buffers::{
+    EmitOut, EDGE_KINDS, EDGE_ROW_SIZE, FUNCTION_REF_CODE, NODE_KINDS, NODE_ROW_SIZE, NONE,
+    REF_ROW_SIZE,
+};
+
+/// Languages the kernel can extract, by CodeGraph's language names.
+pub const LANGUAGES: &[&str] = &crate::langs::LANGUAGES;
+
+/// One extracted node (symbol, file, import, parameter, ...).
+#[derive(Debug, Clone)]
+pub struct Node {
+    /// CodeGraph node kind, e.g. `function`, `method`, `class`, `import`.
+    pub kind: &'static str,
+    pub name: String,
+    pub qualified_name: String,
+    pub id: String,
+    /// 1-based, inclusive.
+    pub start_line: u32,
+    pub end_line: u32,
+    /// 0-based, UTF-16 code units (CodeGraph's JS convention).
+    pub start_column: u32,
+    pub end_column: u32,
+    pub docstring: Option<String>,
+    pub signature: Option<String>,
+    pub decorators: Vec<String>,
+    pub type_parameters: Vec<String>,
+    pub return_type: Option<String>,
+    /// 0 absent, 1 public, 2 private, 3 protected, 4 internal.
+    pub visibility: u8,
+    /// `(present, value)` pairs packed as in buffers.rs.
+    pub flags: u16,
+}
+
+/// One edge the walker emitted inside the file (`contains`, ...).
+#[derive(Debug, Clone)]
+pub struct Edge {
+    pub kind: &'static str,
+    /// Row index into `Extraction::nodes`, when the endpoint is in this file.
+    pub source: Option<u32>,
+    pub target: Option<u32>,
+    pub source_id: Option<String>,
+    pub target_id: Option<String>,
+    pub line: Option<u32>,
+}
+
+/// One unresolved reference (a call site, import, type use, ...).
+#[derive(Debug, Clone)]
+pub struct Ref {
+    /// An edge kind such as `calls`, or `function_ref`.
+    pub kind: &'static str,
+    pub from: Option<u32>,
+    pub name: String,
+    pub line: u32,
+    pub column: u32,
+}
+
+/// One file's extraction.
+#[derive(Debug, Clone, Default)]
+pub struct Extraction {
+    pub nodes: Vec<Node>,
+    pub edges: Vec<Edge>,
+    pub refs: Vec<Ref>,
+}
+
+/// Why a file produced no extraction. CodeGraph's TS side routes `Defer`
+/// and `Timeout` to its wasm extractor; a plain-Rust caller gets nothing.
+#[derive(Debug, Clone)]
+pub enum ExtractError {
+    /// `defer:` - a parse tree with errors, or the walker's stack guard.
+    Defer(String),
+    /// `timeout:` - the parse ran past its budget.
+    Timeout(String),
+    Other(String),
+}
+
+/// Extract one file. `language` is a CodeGraph language name (see
+/// [`LANGUAGES`]); anything unknown falls through to the TS/JS walker, as in
+/// `extract_file`. Run it on a thread with a generous stack: the walkers
+/// recurse per AST level (the stack guard defers instead of overflowing).
+pub fn extract(
+    file_path: &str,
+    content: &str,
+    language: &str,
+    parse_budget_ms: Option<u32>,
+) -> Result<Extraction, ExtractError> {
+    use crate::*;
+    let out = parse_budget::with_budget(parse_budget_ms, || {
+        stack::run_guarded(|| match language {
+            "java" => java::extract(file_path, content),
+            "python" => python::extract(file_path, content),
+            "go" => go::extract(file_path, content),
+            "c" | "cpp" => ccpp::extract(file_path, content, language),
+            "rust" => rustlang::extract(file_path, content),
+            "csharp" => csharp::extract(file_path, content),
+            "ruby" => ruby::extract(file_path, content),
+            "php" => php::extract(file_path, content),
+            "swift" => swift::extract(file_path, content),
+            "kotlin" => kotlin::extract(file_path, content),
+            "r" => rlang::extract(file_path, content),
+            "lua" | "luau" => lua::extract(file_path, content, language),
+            "scala" => scala::extract(file_path, content),
+            "dart" => dart::extract(file_path, content),
+            _ => tsjs::extract(file_path, content, language),
+        })
+    })
+    .map_err(|e| {
+        if e.starts_with("defer:") {
+            ExtractError::Defer(e)
+        } else if e.starts_with("timeout:") {
+            ExtractError::Timeout(e)
+        } else {
+            ExtractError::Other(e)
+        }
+    })?;
+    Ok(decode(&out))
+}
+
+fn u32_at(b: &[u8], o: usize) -> u32 {
+    u32::from_le_bytes([b[o], b[o + 1], b[o + 2], b[o + 3]])
+}
+
+fn opt_idx(v: u32) -> Option<u32> {
+    (v != NONE).then_some(v)
+}
+
+fn decode(out: &EmitOut) -> Extraction {
+    let arena = &out.arena;
+    let s = |b: &[u8], o: usize| -> Option<String> {
+        let off = u32_at(b, o);
+        let len = u32_at(b, o + 4) as usize;
+        (off != NONE).then(|| String::from_utf8_lossy(&arena[off as usize..off as usize + len]).into_owned())
+    };
+    let list = |b: &[u8], o: usize| -> Vec<String> {
+        s(b, o).map(|v| v.split('\0').map(str::to_string).collect()).unwrap_or_default()
+    };
+    let nodes = out
+        .nodes
+        .chunks_exact(NODE_ROW_SIZE)
+        .map(|r| Node {
+            kind: NODE_KINDS.get(r[0] as usize).copied().unwrap_or("?"),
+            visibility: r[1],
+            flags: u16::from_le_bytes([r[2], r[3]]),
+            start_line: u32_at(r, 4),
+            end_line: u32_at(r, 8),
+            start_column: u32_at(r, 12),
+            end_column: u32_at(r, 16),
+            name: s(r, 20).unwrap_or_default(),
+            qualified_name: s(r, 28).unwrap_or_default(),
+            id: s(r, 36).unwrap_or_default(),
+            docstring: s(r, 44),
+            signature: s(r, 52),
+            decorators: list(r, 60),
+            type_parameters: list(r, 68),
+            return_type: s(r, 76),
+        })
+        .collect();
+    let edges = out
+        .edges
+        .chunks_exact(EDGE_ROW_SIZE)
+        .map(|r| Edge {
+            source: opt_idx(u32_at(r, 0)),
+            target: opt_idx(u32_at(r, 4)),
+            kind: EDGE_KINDS.get(r[8] as usize).copied().unwrap_or("?"),
+            line: opt_idx(u32_at(r, 12)),
+            source_id: s(r, 28),
+            target_id: s(r, 36),
+        })
+        .collect();
+    let refs = out
+        .refs
+        .chunks_exact(REF_ROW_SIZE)
+        .map(|r| Ref {
+            from: opt_idx(u32_at(r, 0)),
+            kind: if r[4] == FUNCTION_REF_CODE {
+                "function_ref"
+            } else {
+                EDGE_KINDS.get(r[4] as usize).copied().unwrap_or("?")
+            },
+            line: u32_at(r, 8),
+            column: u32_at(r, 12),
+            name: s(r, 16).unwrap_or_default(),
+        })
+        .collect();
+    Extraction { nodes, edges, refs }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn extracts_a_python_function_with_its_docstring() {
+        let src = "def greet(name: str) -> str:\n    \"\"\"Say hello.\"\"\"\n    return name\n";
+        let x = super::extract("a.py", src, "python", None).expect("extracts");
+        let f = x.nodes.iter().find(|n| n.kind == "function").expect("a function");
+        assert_eq!(f.name, "greet");
+        assert_eq!((f.start_line, f.end_line), (1, 3));
+        assert_eq!(f.docstring.as_deref(), Some("Say hello."));
+        assert!(f.signature.as_deref().unwrap_or("").contains("name: str"));
+    }
+}
