+        let mut text = String::from("1. Big\n");
+        for i in 0..2000 {
+            text.push_str(&format!(
+                "\nRule {i}: the server MUST do this one thing well."
+            ));
+        }
+        let doc = DocumentRecord {
+            path: "big",
+            language: None,
+            content_hash: b"big",
+            size_bytes: 1,
+            dirty: false,
+            text: None,
+            chunks: vec![section("1", "Big", None, 1, &text)],
