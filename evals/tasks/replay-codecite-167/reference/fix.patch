+        );
+        assert!(
+            human.contains("#section-2.1 · Logout Token (referenced)"),
+            "{human}"
+        );
+        assert!(
+            human.contains("  [REQUIRED] exp: REQUIRED. Expiration time."),
+            "{human}"
+        );
+    }
