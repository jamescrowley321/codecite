+            .unwrap_err();
+        assert_eq!(err.kind(), "stale_index");
+        let err = store
+            .requirements_on("decrypt", "Logout", &RequirementsOptions::default())
+            .unwrap_err();
+        assert_eq!(err.kind(), "stale_index");
+        let allowed = RequirementsOptions { allow_stale: true };
