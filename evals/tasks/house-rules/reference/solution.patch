+def import_roles(
+    tenant_roles: Sequence[Role],
+    command: ImportRoles,
+    *,
+    role_ids: Sequence[uuid.UUID],
+    now: datetime,
+) -> Result[tuple[tuple[Role, ...], tuple[str, ...], tuple[RoleCreated, ...]], AccessError]:
+    """``tenant_roles`` are the roles the command's tenant already has; ``role_ids``
+    holds an id for each catalogue role, in order.
+
+    A catalogue role whose name the tenant already has, or that the catalogue lists
+    twice, is skipped. Returns the roles to create, the skipped names and an event
+    per created role.
+    """
+    taken = {role.name.value for role in tenant_roles}
+    created: list[Role] = []
+    skipped: list[str] = []
+    events: list[RoleCreated] = []
+    for entry, role_id in zip(command.roles, role_ids, strict=True):
+        if entry.name.value in taken:
+            skipped.append(entry.name.value)
+            continue
+        taken.add(entry.name.value)
+        decision = create_role(
+            None,
+            CreateRole(name=entry.name, description=entry.description, tenant_id=command.tenant_id),
+            role_id=role_id,
+            now=now,
+        )
+        if decision.is_error():
+            return Error(decision.error)
+        role, event = decision.ok
+        created.append(role)
+        events.append(event)
+    return Ok((tuple(created), tuple(skipped), tuple(events)))
+
+
 def update_role(
