+        ):
+            logger.warning("partner catalogue sent no role list for tenant %s", tenant_id)
+            return Error(ProviderError(message="Partner catalogue sent an unreadable body"))
+        return Ok([(entry["name"], str(entry.get("description") or "")) for entry in roles])
