+    async def import_roles(
+        self,
+        *,
+        tenant_id: uuid.UUID,
+    ) -> Result[dict, IdentityError]:
+        """Create the roles the partner catalogue lists for a tenant, as that tenant's roles.
+
+        A name the tenant already has is skipped. A catalogue that cannot be read, or a
+        name that is not a valid role name, imports nothing.
+        """
+        with tracer.start_as_current_span("RoleService.import_roles") as span:
+            span.set_attribute("tenant.id", str(tenant_id))
+
+            listed = await self._fetch_catalogue(tenant_id)
+            if listed.is_error():
+                return Error(listed.error)
+            entries = []
+            for name, description in listed.ok:
+                parsed = access.role_name(name)
+                if parsed.is_error():
+                    return Error(identity_error(parsed.error))
+                entries.append(access.CatalogueRole(name=parsed.ok, description=description))
+            command = access.ImportRoles(tenant_id=tenant_id, roles=tuple(entries))
+
+            held = [role_from_row(row) for row in await self._repository.list_by_tenant(tenant_id)]
+            decision = access.import_roles(
+                held,
+                command,
+                role_ids=[uuid.uuid4() for _ in entries],
+                now=_now(),
+            )
+            if decision.is_error():
+                return Error(identity_error(decision.error))
+            created, skipped, events = decision.ok
+
+            try:
+                for role in created:
+                    await self._repository.create(role_to_row(role))
+            except RepositoryConflictError:
+                await self._repository.rollback()
+                return Error(Conflict(message="A catalogue role was created in this tenant during the import"))
+            await self._repository.commit()
+            span.set_attribute("roles.created", len(created))
+
+            for role, event in zip(created, events, strict=True):
+                await self._invalidate(event, role.id, tenant_id)
+                self._log_sync_failure(
+                    await self._adapter.sync_role(
+                        role_id=role.id,
+                        data={"name": role.name.value, "description": role.description},
+                    ),
+                    role.id,
+                    "import_roles",
+                )
+
+            return Ok({"created": [role.name.value for role in created], "skipped": list(skipped)})
+
+    async def _fetch_catalogue(self, tenant_id: uuid.UUID) -> Result[list[tuple[str, str]], IdentityError]:
+        """The (name, description) of each role the partner catalogue lists for the tenant."""
+        base = knob("PARTNER_CATALOGUE_URL", "http://partner-catalogue.internal").rstrip("/")
+        try:
+            async with outbound_client(timeout=_CATALOGUE_TIMEOUT) as client:
+                response = await client.get(f"{base}/tenants/{tenant_id}/roles")
+                response.raise_for_status()
+                body = response.json()
+        except UpstreamStatusError as exc:
+            logger.warning(
+                "partner catalogue answered %s for tenant %s: %s",
+                exc.response.status_code,
+                tenant_id,
+                exc.response.text[:500],
+            )
+            return Error(ProviderError(message=f"Partner catalogue answered {exc.response.status_code}"))
+        except UpstreamTransportError as exc:
+            logger.warning("partner catalogue unreachable for tenant %s: %s", tenant_id, type(exc).__name__)
+            return Error(ProviderError(message="Partner catalogue unreachable"))
+        except ValueError:
+            logger.warning("partner catalogue sent a body that is not JSON for tenant %s", tenant_id)
+            return Error(ProviderError(message="Partner catalogue sent an unreadable body"))
+        roles = body.get("roles") if isinstance(body, dict) else None
+        if not isinstance(roles, list) or not all(
