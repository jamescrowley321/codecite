+    const NEW_2_4: &str = "2.4. Logout Token\n\nsub\nREQUIRED. Subject, [Core] (S., “Core,” December 2023.).\niat\nREQUIRED. Issued at, [Core] (S., “Core,” December 2023.).\nexp\nREQUIRED. Expiration time, [Core] (S., “Core,” December 2023.).";
