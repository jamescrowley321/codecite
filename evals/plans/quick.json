{
  "task": "fastapi-middleware",
  "runs": 10,
  "seed": 20261020,
  "timeoutSec": 360,
  "repos": {
    "identity-model": "~/repos/auth/identity-model"
  },
  "agents": [
    {
      "agent": "claude",
      "model": "claude-opus-5-5"
    },
    {
      "agent": "claude",
      "model": "claude-sonnet-5-5"
    },
    {
      "agent": "pi",
      "model": "openai/gpt-6.1-sol"
    },
    {
      "agent": "pi",
      "model": "google/gemini-4-argon"
    },
    {
      "agent": "pi",
      "model": "mistralai/devstral-2512"
    },
    {
      "agent": "pi",
      "model": "deepseek/deepseek-v4.1-flash"
    }
  ],
  "arms": [
    {
      "name": "baseline"
    },
    {
      "name": "codecite",
      "codecite": true,
      "note": "The `codecite` command is on your PATH. Its corpus `eval` indexes the identity-model source at `{identity_model}`. `codecite search eval \"<query>\"` prints ranked results with citations, and `codecite read eval \"<citation>\"` prints the text a citation points at."
    }
  ],
  "concurrency": 12,
  "maxPerModel": 4
}
